# --- Obsidian:保留共用設定,忽略本機/易變狀態 ---
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph-default.json
.obsidian/plugins/*/data.json
.trash/

# --- 委託任務(本機暫存,不入庫) ---
quests/

# --- 作業系統雜訊 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 暫存/逐字稿等 ---
*.tmp
_transcripts.json.br

# --- Git Bash 在 Windows 上偶爾產生的當機轉存檔 ---
*.stackdump

# --- Python ---
__pycache__/
*.pyc

# --- 研究原始資料:第三方逐字稿等,不進版控 ---
research/*/data/

# --- 媒體暫存 ---
*.webm
*.m4a
*.mp4
